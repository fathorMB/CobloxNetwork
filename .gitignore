# Rust build output (workspace target/ plus the standalone src-tauri crate,
# which is excluded from the workspace and builds into its own target/).
target/
**/target/

# Node.js dependencies and package-manager caches
node_modules/
.npm/

# Frontend build output (apps/desktop/dist, produced by `npm run build`)
dist/

# Tauri-generated files. Mirrors upstream tauri-apps/tauri's own .gitignore,
# which excludes `src-tauri/gen/` in its examples: the ACL/capability JSON
# schemas under gen/schemas/ are regenerated by the Tauri CLI on every build
# from tauri.conf.json and the capability files, so they are a build output,
# not a source of truth, and are intentionally not versioned here.
apps/desktop/src-tauri/gen/

# Android/Gradle build output and local machine configuration
apps/android/**/build/
apps/android/.gradle/
apps/android/local.properties
# Native library produced by `scripts/build-android.sh` / cargo-ndk; CI
# publishes it as a workflow artifact instead of committing it.
apps/android/core/src/main/jniLibs/

# Editor/IDE noise
.idea/
*.iml

# OS noise
.DS_Store
Thumbs.db

# Per-machine agent-harness configuration. These files hold absolute paths and
# the local username, and the repository is public: they are excluded rather
# than left untracked by convention. If a harness configuration ever needs to
# be shared, commit a portable copy with relative paths instead, the way
# .lmbrain/mcp/lmbrain-mcp.json already does.
.codex/
.pi/
.mcp.json
opencode.json

# Python bytecode cache (simulatore economico in sim/)
__pycache__/
*.py[cod]

# Devnet runtime state. A validator's --data-dir holds wal.jsonl (its signed
# votes) and blocks.jsonl (its chain); the per-node logs are the runbook's
# redirected stdout. Both are produced by running docs/devnet-runbook.md and
# neither belongs in a public repository. The node no longer defaults --data-dir
# anywhere, so these patterns cover the paths the runbook itself uses.
# [REVIEW-049] RF-005, [DEBT-049].
data/
data-val*.log
