{
  "$schema": "./tokens.schema.json",
  "$meta": {
    "name": "Coblox Design Tokens",
    "version": "0.1.0",
    "spec": "SPEC-003",
    "owner": "AGENT-006",
    "cssPrefix": "cbx",
    "description": "Source of truth for the Coblox design system. CSS custom properties in tokens.css are GENERATED from this file by build-tokens.mjs. Never edit tokens.css by hand.",
    "namingRules": [
      "Primitives are raw, screen-agnostic values: color.green.400, space.4, font.size.md.",
      "Semantics describe ROLE, never screen or component: color.bg.app, color.flow.mint. A name like 'dashboard-header-green' is forbidden.",
      "Semantic names are platform-neutral so they can be re-emitted for Jetpack Compose later (color.bg.app -> ColorBgApp) without renaming.",
      "Only semantic tokens may be used in product surfaces. Primitives are consumed by semantics only."
    ],
    "unit": {
      "note": "Decided by ADR-009. The unit is a measure, not a currency: it renders POSPOSED to the number (after it), never before it, and never as a standalone glyph or symbol.",
      "name": "credit",
      "namePlural": "credits",
      "compact": "cr",
      "cssClass": "cbx-unit"
    }
  },

  "primitive": {
    "color": {
      "ink": {
        "950": "#060A08",
        "900": "#0B100E",
        "850": "#111815",
        "800": "#18211D",
        "750": "#1F2A25",
        "700": "#27352F"
      },
      "grey": {
        "700": "#33443C",
        "600": "#485D54",
        "500": "#5F776D",
        "400": "#879C93",
        "300": "#A9BCB3",
        "200": "#C9D8D1",
        "100": "#E3EDE8",
        "050": "#F2F7F5"
      },
      "paper": {
        "000": "#FFFFFF",
        "050": "#F4F7F5",
        "100": "#E8EEEB",
        "200": "#D6E0DB",
        "300": "#B9C7C1"
      },
      "green": {
        "100": "#DDF9EC",
        "200": "#B4F7D8",
        "300": "#82EFC0",
        "400": "#4FE3A3",
        "500": "#1FC486",
        "600": "#12A06C",
        "700": "#0B7C53",
        "800": "#0A5C3E",
        "900": "#0C2A1F",
        "950": "#071A13"
      },
      "cyan": {
        "100": "#DEF5F8",
        "300": "#93E9F1",
        "400": "#54D6E2",
        "600": "#12879A",
        "700": "#0C6A7A",
        "900": "#0A272C"
      },
      "amber": {
        "100": "#FBEDD5",
        "300": "#F8CE8A",
        "400": "#F2B04A",
        "600": "#B87413",
        "700": "#8F590C",
        "900": "#2C2009"
      },
      "red": {
        "100": "#FCDFDF",
        "300": "#FFB3B3",
        "400": "#FF8585",
        "600": "#CF3B3B",
        "700": "#A82C2C",
        "900": "#331111"
      },
      "violet": {
        "100": "#EBE5FF",
        "300": "#D2C4FF",
        "400": "#B39CFF",
        "600": "#6D4FD1",
        "700": "#563BAF",
        "900": "#1E1938"
      }
    },

    "font": {
      "family": {
        "mono": "\"JetBrains Mono\", \"Fira Code\", \"IBM Plex Mono\", ui-monospace, \"Cascadia Mono\", \"SF Mono\", Consolas, \"DejaVu Sans Mono\", monospace",
        "sans": "Inter, \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, Roboto, \"Helvetica Neue\", Arial, sans-serif"
      },
      "size": {
        "3xs": "0.6875rem",
        "2xs": "0.75rem",
        "xs": "0.8125rem",
        "sm": "0.875rem",
        "md": "0.9375rem",
        "lg": "1.0625rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "2rem",
        "4xl": "2.75rem"
      },
      "weight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      },
      "lineHeight": {
        "tight": "1.2",
        "snug": "1.35",
        "normal": "1.5",
        "relaxed": "1.65"
      },
      "letterSpacing": {
        "tightest": "-0.02em",
        "tight": "-0.01em",
        "normal": "0",
        "wide": "0.02em",
        "widest": "0.08em"
      }
    },

    "space": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem"
    },

    "radius": {
      "none": "0",
      "xs": "2px",
      "sm": "4px",
      "md": "6px",
      "lg": "10px",
      "pill": "999px"
    },

    "border": {
      "width": {
        "hairline": "1px",
        "thick": "2px"
      }
    },

    "duration": {
      "instant": "0ms",
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms",
      "pulse": "2200ms"
    },

    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0.2, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },

    "layout": {
      "sidebarWidth": "232px",
      "topbarHeight": "48px",
      "contentMax": "1180px",
      "rowHeight": "36px",
      "rowHeightDense": "28px",
      "hitTargetMin": "32px"
    }
  },

  "semantic": {
    "_comment": "Role-based tokens. Every key must exist in BOTH themes. Values reference primitives by dotted path with {} or are literal.",

    "dark": {
      "color.bg.app": "{color.ink.900}",
      "color.bg.surface": "{color.ink.850}",
      "color.bg.surface-raised": "{color.ink.800}",
      "color.bg.inset": "{color.ink.950}",
      "color.bg.hover": "{color.ink.750}",
      "color.bg.selected": "{color.green.950}",
      "color.bg.scrim": "rgba(6, 10, 8, 0.72)",

      "color.text.primary": "{color.grey.100}",
      "color.text.secondary": "{color.grey.200}",
      "color.text.muted": "{color.grey.400}",
      "color.text.on-accent": "{color.green.950}",
      "color.text.on-solid": "{color.grey.050}",
      "color.text.link": "{color.green.300}",

      "color.border.subtle": "{color.ink.750}",
      "color.border.default": "{color.ink.700}",
