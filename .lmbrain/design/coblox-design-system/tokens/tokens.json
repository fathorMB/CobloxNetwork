      "color.status.validating-quiet": "{color.cyan.900}",
      "color.status.degraded": "{color.amber.400}",
      "color.status.degraded-quiet": "{color.amber.900}",
      "color.status.offline": "{color.grey.300}",
      "color.status.offline-quiet": "{color.ink.800}",
      "color.status.error": "{color.red.400}",
      "color.status.error-quiet": "{color.red.900}",

      "color.feedback.info": "{color.cyan.400}",
      "color.feedback.info-quiet": "{color.cyan.900}",
      "color.feedback.success": "{color.green.400}",
      "color.feedback.success-quiet": "{color.green.900}",
      "color.feedback.warning": "{color.amber.400}",
      "color.feedback.warning-quiet": "{color.amber.900}",
      "color.feedback.danger": "{color.red.400}",
      "color.feedback.danger-quiet": "{color.red.900}",
      "color.feedback.danger-solid": "{color.red.700}",
      "color.text.on-danger": "{color.grey.050}",

      "color.focus.ring": "{color.green.300}",
      "color.chart.grid": "{color.ink.750}",
      "color.chart.series-1": "{color.green.400}",
      "color.chart.series-2": "{color.cyan.400}",
      "color.chart.series-3": "{color.violet.400}",

      "elevation.glow.accent": "0 0 0 1px rgba(79, 227, 163, 0.35), 0 0 16px -4px rgba(79, 227, 163, 0.45)",
      "elevation.card": "0 1px 0 0 rgba(255, 255, 255, 0.03), 0 8px 24px -16px rgba(0, 0, 0, 0.9)",
      "elevation.overlay": "0 16px 40px -12px rgba(0, 0, 0, 0.85)"
    },

    "light": {
