{
  "$meta": {
    "description": "Every text/background and non-text pairing the Coblox design system declares LEGITIMATE. Checked by design/tools/check-contrast.mjs against WCAG 2.1. A pairing that is not listed here is not sanctioned: components must not invent combinations.",
    "spec": "SPEC-003",
    "thresholds": {
      "text": 4.5,
      "text-large": 3.0,
      "non-text": 3.0
    },
    "note": "The system deliberately holds even 'muted' text to the 4.5 text threshold rather than the 3.0 large-text relaxation. Low-contrast body text is the classic failure mode of terminal-inspired UIs and is banned here."
  },
  "exempt": [
    {
      "tokens": [
        "color.border.subtle",
        "color.border.default",
        "color.chart.grid"
      ],
      "reason": "Purely decorative separators and gridlines. They never carry information on their own: every row, card and chart datum is also distinguished by spacing, a label, or a token from the checked set. WCAG 1.4.11 does not apply to purely decorative boundaries.",
      "compensating-control": "Wherever a boundary is load-bearing (focused input, selected row, table header rule), the design uses color.border.strong / color.border.accent / color.focus.ring, all of which ARE checked at the 3.0 non-text threshold."
    },
    {
      "tokens": [
        "color.bg.scrim",
        "elevation.glow.accent",
        "elevation.card",
        "elevation.overlay"
      ],
      "reason": "Translucent overlays and shadows. Their contribution is not a fixed foreground/background pair; legibility is guaranteed by the surface tokens composited above them, which are checked."
    },
    {
      "tokens": [
        "color.focus.ring against a filled control"
      ],
      "reason": "The focus ring is never drawn flush against the control it belongs to: components set `outline: 2px solid var(--cbx-color-focus-ring)` together with `outline-offset: 2px`, so the ring's adjacent colour is always the page or card background, not the button fill.",
      "compensating-control": "The ring-vs-background pairs (color.focus.ring on color.bg.app and on color.bg.surface) ARE checked at the 3.0 non-text threshold, which is the pairing WCAG 1.4.11 actually evaluates for a detached indicator."
    }
  ],
